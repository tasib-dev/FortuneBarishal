PORT=5000
# Make a long random secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste-your-long-random-secret-here

# PostgreSQL connection:  postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/fortunebarishal
# Set to true when using a hosted database (Neon, Supabase, Render, Railway...)
DATABASE_SSL=false
